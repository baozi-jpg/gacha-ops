<Window x:Class="GachaOps.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GachaOps 二游自动化总控" Height="820" Width="1220"
        Icon="Assets/GachaOps.ico"
        MinHeight="700" MinWidth="1000" Background="{StaticResource PageBackground}"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <Style x:Key="ToggleSwitchCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="22" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource {x:Static SystemParameters.FocusVisualStyleKey}}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Track" Width="38" Height="22" CornerRadius="11"
                                Background="#667085" BorderBrush="Transparent" BorderThickness="1">
                            <Ellipse x:Name="Thumb" Width="18" Height="18" Fill="White"
                                     HorizontalAlignment="Left" VerticalAlignment="Center" Margin="1,0,0,0" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource PrimaryBrush}" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,1,0" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Track" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SettingsExpanderStyle" TargetType="Expander">
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <Border Background="{StaticResource SecondarySurfaceBrush}" CornerRadius="8" Padding="14,6">
                                    <ToggleButton Content="{TemplateBinding Header}" FontSize="17" FontWeight="SemiBold"
                                                  Style="{StaticResource ExpanderHeaderStyle}"
                                                  IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                                </Border>
                                <Border x:Name="SettingsContent" Visibility="Collapsed" Padding="20,16,20,20"
                                        BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0">
                                    <ContentPresenter ContentSource="Content" />
                                </Border>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="SettingsContent" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RunStateBadgeStyle" TargetType="Border">
            <Setter Property="Width" Value="64" />
            <Setter Property="Height" Value="28" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
    </Window.Resources>
    <Grid ClipToBounds="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="78" />
            <RowDefinition Height="*" />
            <RowDefinition Height="42" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Margin="18,14,18,0" Background="{StaticResource ChromeBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                CornerRadius="6" Padding="22,0">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="RunAllButton" Content="运行已启用任务" Click="RunAllButton_Click" Width="146" />
                    <Button x:Name="StopAfterCurrentButton" Content="停止后续任务"
                            Click="StopAfterCurrentButton_Click" Style="{StaticResource SecondaryButton}"
                            IsEnabled="False" Width="138" Margin="10,0,0,0" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="GachaOps" FontSize="25" FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryTextBrush}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <TabControl x:Name="MainTabControl" Grid.Row="1" Margin="24,18,24,14"
                    SelectionChanged="MainTabControl_SelectionChanged">
            <TabItem Header="总览">
                <ScrollViewer Style="{StaticResource OverlayScrollViewerStyle}"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="2,0,2,10">
                        <Grid x:Name="WorkflowChannelsGrid">
                            <Grid.Resources>
                                <DataTemplate x:Key="WorkflowTaskCardTemplate">
                                    <Border Padding="10" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                                            TextElement.Foreground="{StaticResource PrimaryTextBrush}"
                                            BorderThickness="1" CornerRadius="6" MinHeight="104">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28" />
                                                <ColumnDefinition Width="44" />
                                                <ColumnDefinition Width="46" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.RowSpan="2" Width="24" Height="48" Background="{StaticResource SecondarySurfaceBrush}" CornerRadius="8"
                                                    Cursor="SizeAll" ToolTip="拖动到其他通道或调整顺序（Alt+方向键）"
                                                    IsEnabled="{Binding IsWorkflowEditable}"
                                                    PreviewMouseLeftButtonDown="DragHandle_PreviewMouseLeftButtonDown"
                                                    PreviewMouseLeftButtonUp="DragHandle_PreviewMouseLeftButtonUp"
                                                    PreviewMouseMove="DragHandle_PreviewMouseMove">
                                                <TextBlock Text="⋮⋮" FontSize="16" Foreground="{StaticResource MutedTextBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>

                                            <CheckBox Grid.Column="1" VerticalAlignment="Center"
                                                      HorizontalAlignment="Center" IsChecked="{Binding IsEnabled}"
                                                      IsEnabled="{Binding IsWorkflowEditable}" ToolTip="启用此任务"
                                                      Style="{StaticResource ToggleSwitchCheckBoxStyle}" />

                                            <Grid Grid.Column="2" Width="42" Height="42" VerticalAlignment="Center">
                                                <Border Background="{Binding FallbackBackground}" CornerRadius="11">
                                                    <TextBlock Text="{Binding FallbackGlyph}" Foreground="{Binding FallbackForeground}"
                                                               FontSize="17" FontWeight="SemiBold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <Image Source="{Binding Icon}" Width="38" Height="38" Stretch="Uniform">
                                                    <Image.Style>
                                                        <Style TargetType="Image">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Image.Style>
                                                </Image>
                                            </Grid>

                                            <StackPanel Grid.Column="3" Margin="9,0,8,0" VerticalAlignment="Center">
                                                <TextBlock FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                                                    <Run Text="{Binding GameName, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding ToolName, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock Text="{Binding Profile}" Margin="0,3,0,0" FontSize="12"
                                                           Foreground="{StaticResource MutedTextBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>

                                            <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,9,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Style="{StaticResource RunStateBadgeStyle}"
                                                        Background="{Binding StatusBackground}"
                                                        HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Status}" Foreground="{Binding StatusForeground}"
                                                               FontSize="11" FontWeight="SemiBold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               TextAlignment="Center" />
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{Binding Message}" Margin="8,0"
                                                           VerticalAlignment="Center" FontSize="12" TextWrapping="NoWrap"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{StaticResource MutedTextBrush}" />
                                                <TextBlock Grid.Column="2" Text="{Binding Duration}" VerticalAlignment="Center"
                                                           FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                                            </Grid>

                                        </Grid>
                                    </Border>
                                </DataTemplate>

                                <Style x:Key="WorkflowChannelListStyle" TargetType="ListBox"
                                       BasedOn="{StaticResource {x:Type ListBox}}">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="SelectionMode" Value="Single" />
                                    <Setter Property="ItemTemplate" Value="{StaticResource WorkflowTaskCardTemplate}" />
                                    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
                                    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
                                    <Setter Property="ItemContainerStyle">
                                        <Setter.Value>
                                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                                <Setter Property="Padding" Value="0" />
                                                <Setter Property="Margin" Value="0,0,0,8" />
                                            </Style>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Grid.Resources>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border x:Name="WorkflowChannel1Lane" Grid.Column="0" Tag="1" Margin="0,0,6,0"
                                    Padding="12" MinHeight="176" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="6" AllowDrop="True"
                                    PreviewDragOver="WorkflowChannelLane_PreviewDragOver" Drop="WorkflowChannelLane_Drop">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <DockPanel Margin="2,0,2,11">
                                        <Border DockPanel.Dock="Left" Width="28" Height="28" CornerRadius="6"
                                                Background="{StaticResource PrimaryBrush}">
                                            <TextBlock Text="1" Foreground="White" FontWeight="SemiBold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="通道 1" FontSize="15" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </DockPanel>
                                    <Grid Grid.Row="1">
                                        <TextBlock x:Name="WorkflowChannel1EmptyText" Text="拖动任务到这里" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{StaticResource MutedTextBrush}" IsHitTestVisible="False">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasItems, ElementName=WorkflowChannel1ListBox}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <ListBox x:Name="WorkflowChannel1ListBox" Style="{StaticResource WorkflowChannelListStyle}"
                                                 PreviewKeyDown="WorkflowChannelListBox_PreviewKeyDown" />
                                    </Grid>
                                    <Border x:Name="WorkflowChannel1DropHighlight" Grid.RowSpan="2" Margin="-5"
                                            Background="#162563EB" BorderBrush="{StaticResource PrimaryBrush}"
                                            BorderThickness="2" CornerRadius="6" Opacity="0" IsHitTestVisible="False" />
                                </Grid>
                            </Border>

                            <Border x:Name="WorkflowChannel2Lane" Grid.Column="1" Tag="2" Margin="6,0,0,0"
                                    Padding="12" MinHeight="176" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="6" AllowDrop="True"
                                    PreviewDragOver="WorkflowChannelLane_PreviewDragOver" Drop="WorkflowChannelLane_Drop">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <DockPanel Margin="2,0,2,11">
                                        <Border DockPanel.Dock="Left" Width="28" Height="28" CornerRadius="6"
                                                Background="{StaticResource PrimaryBrush}">
                                            <TextBlock Text="2" Foreground="White" FontWeight="SemiBold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="通道 2" FontSize="15" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </DockPanel>
                                    <Grid Grid.Row="1">
                                        <TextBlock x:Name="WorkflowChannel2EmptyText" Text="拖动任务到这里" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{StaticResource MutedTextBrush}" IsHitTestVisible="False">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasItems, ElementName=WorkflowChannel2ListBox}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <ListBox x:Name="WorkflowChannel2ListBox" Style="{StaticResource WorkflowChannelListStyle}"
                                                 PreviewKeyDown="WorkflowChannelListBox_PreviewKeyDown" />
                                    </Grid>
                                    <Border x:Name="WorkflowChannel2DropHighlight" Grid.RowSpan="2" Margin="-5"
                                            Background="#162563EB" BorderBrush="{StaticResource PrimaryBrush}"
                                            BorderThickness="2" CornerRadius="6" Opacity="0" IsHitTestVisible="False" />
                                </Grid>
                            </Border>

                        </Grid>

                        <Border Margin="0,16,0,0" Padding="20" Style="{StaticResource CardBorderStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel>
                                    <TextBlock Text="本次运行进度" FontSize="18" FontWeight="SemiBold" />
                                </StackPanel>
                                <Grid Grid.Row="1" MinHeight="126" Margin="0,14,0,0">
                                    <ListBox x:Name="ActivityListBox" Background="Transparent" BorderThickness="0"
                                             Padding="0" MaxHeight="230" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="2,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="16" />
                                                        <ColumnDefinition Width="72" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Ellipse Width="8" Height="8" Fill="{Binding Accent}"
                                                             VerticalAlignment="Top" Margin="0,6,0,0" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Time}"
                                                               Foreground="{StaticResource MutedTextBrush}" />
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock FontWeight="SemiBold">
                                                            <Run Text="{Binding ToolName}" /><Run Text=" · " /><Run Text="{Binding State}" />
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding Message}" Margin="0,3,0,0" TextWrapping="Wrap"
                                                                   Visibility="{Binding MessageVisibility}"
                                                                   Foreground="{StaticResource MutedTextBrush}" />
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <StackPanel x:Name="ActivityEmptyState" HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="还没有运行记录" FontSize="16" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                                <Expander x:Name="TechnicalLogExpander" Grid.Row="2" Margin="0,12,0,0"
                                          Header="技术日志" Style="{StaticResource AnimatedExpanderStyle}"
                                          Expanded="TechnicalLogExpander_Expanded"
                                          Collapsed="TechnicalLogExpander_Collapsed">
                                    <Grid Margin="0,12,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <DockPanel Margin="0,0,0,8">
                                            <Button x:Name="CopyLogButton" DockPanel.Dock="Right" Content="复制日志"
                                                    Width="96" Click="CopyLogButton_Click"
                                                    Style="{StaticResource SecondaryButton}" IsEnabled="False" />
                                        </DockPanel>
                                        <TextBox x:Name="LiveLogTextBox" Grid.Row="1" Height="170" IsReadOnly="True"
                                                 TextWrapping="NoWrap" AcceptsReturn="True"
                                                 Padding="12,9" VerticalContentAlignment="Stretch" VerticalScrollBarVisibility="Auto"
                                                 HorizontalScrollBarVisibility="Auto" FontFamily="Cascadia Mono, Consolas"
                                                 FontSize="12.5" Background="{StaticResource InputSurfaceBrush}" />
                                    </Grid>
                                </Expander>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="历史">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="2,0,2,12">
                        <Button DockPanel.Dock="Right" Content="刷新记录" Width="104"
                                Click="RefreshHistoryButton_Click" Style="{StaticResource SecondaryButton}" />
                        <Button DockPanel.Dock="Right" Content="选中轮次详情" Margin="0,0,8,0"
                                Click="HistoryRunDetailsButton_Click" Style="{StaticResource SecondaryButton}" />
                        <Button x:Name="LastRunDetailsButton" DockPanel.Dock="Right" Content="本轮详情" Margin="0,0,8,0"
                                IsEnabled="False" Click="LastRunDetailsButton_Click" Style="{StaticResource SecondaryButton}" />
                        <StackPanel>
                            <TextBlock Text="运行历史" FontSize="22" FontWeight="SemiBold" />
                        </StackPanel>
                    </DockPanel>
                    <Border Grid.Row="1" Padding="4" Style="{StaticResource CardBorderStyle}">
                        <Grid>
                            <DataGrid x:Name="HistoryGrid" IsReadOnly="True" AutoGenerateColumns="False"
                                       CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False"
                                       SelectionMode="Single" AlternationCount="2" RowHeight="NaN" MinRowHeight="54"
                                       EnableRowVirtualization="True" EnableColumnVirtualization="True"
                                       VirtualizingPanel.VirtualizationMode="Recycling"
                                       ScrollViewer.CanContentScroll="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="开始时间" Binding="{Binding StartedAt}" Width="175" />
                                    <DataGridTextColumn Header="工具" Binding="{Binding ToolName}" Width="180" />
                                    <DataGridTemplateColumn Header="状态" Width="105">
                                        <DataGridTemplateColumn.CellStyle>
                                            <Style TargetType="DataGridCell"
                                                   BasedOn="{StaticResource {x:Type DataGridCell}}">
                                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                                                <Setter Property="VerticalContentAlignment" Value="Center" />
                                            </Style>
                                        </DataGridTemplateColumn.CellStyle>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource RunStateBadgeStyle}"
                                                        Background="{Binding StateBackground}"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding State}" Foreground="{Binding StateForeground}"
                                                               FontSize="12" FontWeight="SemiBold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               TextAlignment="Center" />
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="耗时" Binding="{Binding Duration}" Width="100" />
                                    <DataGridTemplateColumn Header="结果" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Grid Margin="4,3" VerticalAlignment="Center">
                                                    <TextBlock x:Name="Summary" Text="{Binding Message}" TextWrapping="Wrap" />
                                                    <Expander x:Name="Details" Header="{Binding Message}" Visibility="Collapsed">
                                                        <ScrollViewer MaxHeight="240" Margin="0,6,0,0"
                                                                      VerticalScrollBarVisibility="Auto"
                                                                      HorizontalScrollBarVisibility="Disabled">
                                                            <TextBlock Text="{Binding Record.Message}" TextWrapping="Wrap" />
                                                        </ScrollViewer>
                                                    </Expander>
                                                </Grid>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding HasDetails}" Value="True">
                                                        <Setter TargetName="Summary" Property="Visibility" Value="Collapsed" />
                                                        <Setter TargetName="Details" Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel x:Name="HistoryEmptyState" HorizontalAlignment="Center"
                                        VerticalAlignment="Center" Visibility="Collapsed">
                                <TextBlock Text="暂无运行记录" FontSize="17" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="设置">
                <ScrollViewer Style="{StaticResource OverlayScrollViewerStyle}"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="SettingsControlsPanel" Margin="2,0,2,12" Focusable="True">
                        <Expander Header="工具配置" Style="{StaticResource SettingsExpanderStyle}" IsExpanded="True">
                            <StackPanel>
                                <StackPanel>
                                    <DockPanel>
                                        <CheckBox x:Name="UseBetterGiCheckBox" DockPanel.Dock="Right" Content="使用" HorizontalAlignment="Right"
                                                  VerticalAlignment="Center" Click="SettingsToggle_Click" />
                                        <TextBlock Text="原神 · BetterGI" FontSize="17" FontWeight="SemiBold" />
                                    </DockPanel>
                                    <Grid Margin="0,14,0,0" IsEnabled="{Binding IsChecked, ElementName=UseBetterGiCheckBox}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="112" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="88" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="48" />
                                            <RowDefinition Height="48" />
                                            <RowDefinition Height="48" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="程序位置" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" />
                                        <TextBox x:Name="BetterGiPathTextBox" Grid.Column="1" VerticalAlignment="Center"
                                                 KeyDown="SettingsTextInput_KeyDown"
                                                 LostKeyboardFocus="SettingsTextInput_LostKeyboardFocus" />
                                        <Button Grid.Column="3" Content="选择文件" Tag="BetterGi" Click="BrowseButton_Click"
                                                Style="{StaticResource BrowseButton}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="1" Text="运行模式" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" />
                                        <ComboBox x:Name="BetterGiModeComboBox" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3"
                                                  VerticalAlignment="Center" SelectionChanged="BetterGiModeComboBox_SelectionChanged">
                                            <ComboBoxItem Content="一条龙" Tag="OneDragon" />
                                            <ComboBoxItem Content="配置组" Tag="ScriptGroups" />
                                        </ComboBox>
                                        <TextBlock Grid.Row="2" Text="任务配置" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" />
                                        <ComboBox x:Name="BetterGiProfileComboBox" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3"
                                                  VerticalAlignment="Center" IsEditable="False"
                                                  SelectionChanged="SettingsComboBox_SelectionChanged"
                                                  KeyDown="SettingsTextInput_KeyDown"
                                                  LostKeyboardFocus="SettingsTextInput_LostKeyboardFocus" />
                                    </Grid>
                                </StackPanel>
                                <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,18" />
                                <StackPanel>
                                    <DockPanel>
                                        <CheckBox x:Name="UseMaaCheckBox" DockPanel.Dock="Right" Content="使用" HorizontalAlignment="Right"
                                                  VerticalAlignment="Center" Click="SettingsToggle_Click" />
                                        <TextBlock Text="明日方舟 · MAA" FontSize="17" FontWeight="SemiBold" />
                                    </DockPanel>
                                    <Grid Margin="0,14,0,0" IsEnabled="{Binding IsChecked, ElementName=UseMaaCheckBox}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="112" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="88" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="48" />
                                            <RowDefinition Height="48" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="程序位置" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" />
                                        <TextBox x:Name="MaaPathTextBox" Grid.Column="1" VerticalAlignment="Center"
                                                 KeyDown="SettingsTextInput_KeyDown"
                                                 LostKeyboardFocus="SettingsTextInput_LostKeyboardFocus" />
                                        <Button Grid.Column="3" Content="选择文件" Tag="Maa" Click="BrowseButton_Click"
                                                Style="{StaticResource BrowseButton}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="1" Text="运行配置" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" />
                                        <ComboBox x:Name="MaaProfileComboBox" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3"
                                                  VerticalAlignment="Center" IsEditable="False"
                                                  SelectionChanged="SettingsComboBox_SelectionChanged"
                                                  KeyDown="SettingsTextInput_KeyDown"
                                                  LostKeyboardFocus="SettingsTextInput_LostKeyboardFocus" />
                                    </Grid>
                                </StackPanel>
                                <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,18" />
                                <StackPanel>
                                    <DockPanel>
                                        <CheckBox x:Name="UseMaaEndCheckBox" DockPanel.Dock="Right" Content="使用" HorizontalAlignment="Right"
                                                  VerticalAlignment="Center" Click="SettingsToggle_Click" />
                                        <TextBlock Text="终末地 · MaaEnd" FontSize="17" FontWeight="SemiBold" />
                                    </DockPanel>
                                    <Grid Margin="0,14,0,0" IsEnabled="{Binding IsChecked, ElementName=UseMaaEndCheckBox}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="112" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="88" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="48" />
                                            <RowDefinition Height="48" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="程序位置" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" />
                                        <TextBox x:Name="MaaEndPathTextBox" Grid.Column="1" VerticalAlignment="Center"
                                                 KeyDown="SettingsTextInput_KeyDown"
                                                 LostKeyboardFocus="SettingsTextInput_LostKeyboardFocus" />
                                        <Button Grid.Column="3" Content="选择文件" Tag="MaaEnd" Click="BrowseButton_Click"
                                                Style="{StaticResource BrowseButton}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="1" Text="运行实例" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" />
                                        <ComboBox x:Name="MaaEndInstanceComboBox" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3"
                                                  VerticalAlignment="Center" IsEditable="False"
                                                  SelectionChanged="SettingsComboBox_SelectionChanged"
                                                  KeyDown="SettingsTextInput_KeyDown"
                                                  LostKeyboardFocus="SettingsTextInput_LostKeyboardFocus" />
                                    </Grid>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                    <Button Content="重新扫描配置" Width="136" Click="RefreshProfilesButton_Click"
                                            Style="{StaticResource SecondaryButton}" />
                                    <Button Content="连接检查" Width="112" Margin="10,0,0,0"
                                            Click="ValidateButton_Click" Style="{StaticResource SecondaryButton}" />
                                </StackPanel>
                            </StackPanel>
                        </Expander>

                        <Expander Header="定时运行" Style="{StaticResource SettingsExpanderStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="112" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="44" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="启用定时" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" />
                                <CheckBox x:Name="ScheduledLaunchCheckBox" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center"
                                          Style="{StaticResource ToggleSwitchCheckBoxStyle}" AutomationProperties.Name="启用定时运行" Click="SettingsToggle_Click" />
                                <TextBlock Grid.Row="1" Text="每日时刻" Margin="0,18,0,0" Foreground="{StaticResource MutedTextBrush}" />
                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,8,0,0">
                                    <DockPanel Margin="0,0,0,10">
                                        <Button DockPanel.Dock="Right" Content="添加时刻" Margin="12,0,0,0" Style="{StaticResource SecondaryButton}" Click="AddScheduleButton_Click" />
                                        <StackPanel Orientation="Horizontal">
                                            <Border x:Name="ScheduleHourErrorBorder" BorderThickness="1" CornerRadius="6">
                                                <ComboBox x:Name="ScheduleHourComboBox" Width="80" IsEditable="True" IsTextSearchEnabled="False"
                                                          AutomationProperties.Name="小时" />
                                            </Border>
                                            <TextBlock Text=":" VerticalAlignment="Center" Margin="8,0" />
                                            <Border x:Name="ScheduleMinuteErrorBorder" BorderThickness="1" CornerRadius="6">
                                                <ComboBox x:Name="ScheduleMinuteComboBox" Width="80" IsEditable="True" IsTextSearchEnabled="False"
                                                          AutomationProperties.Name="分钟" />
                                            </Border>
                                        </StackPanel>
                                    </DockPanel>
                                    <ItemsControl x:Name="ScheduleList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="0,0,0,8">
                                                    <Button DockPanel.Dock="Right" Content="移除" Style="{StaticResource SecondaryButton}" Click="RemoveScheduleButton_Click" />
                                                    <CheckBox Content="{Binding Time}" IsChecked="{Binding IsEnabled, Mode=OneWay}" VerticalAlignment="Center" Click="ScheduleRowToggle_Click" />
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock x:Name="ScheduleStatusText" Text="正在检查定时状态" TextWrapping="Wrap" Margin="0,8,0,0" />
                                </StackPanel>
                            </Grid>
                        </Expander>

                        <Expander Header="外部通知" Style="{StaticResource SettingsExpanderStyle}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="112" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="44" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="启用通知" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" />
                                    <CheckBox x:Name="NotificationsEnabledCheckBox" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center"
                                              Style="{StaticResource ToggleSwitchCheckBoxStyle}" AutomationProperties.Name="启用外部通知" Click="SettingsToggle_Click" />
                                    <TextBlock Grid.Row="1" Text="通知时机" Margin="0,12,0,0" Foreground="{StaticResource MutedTextBrush}" />
                                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,12,0,6" IsEnabled="{Binding IsChecked, ElementName=NotificationsEnabledCheckBox}">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                            <CheckBox x:Name="NotifyBeforeScheduledRunCheckBox" Content="定时提醒" AutomationProperties.Name="提前 5 分钟提醒，仅定时运行" Click="SettingsToggle_Click" />
                                            <TextBlock Text="提前 5 分钟" Margin="16,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                            <CheckBox x:Name="NotifyRunStartedCheckBox" Content="开始通知" AutomationProperties.Name="定时开始通知" Click="SettingsToggle_Click" />
                                            <TextBlock Text="仅定时运行" Margin="16,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                            <CheckBox x:Name="NotifyRunResultCheckBox" Content="结果通知" AutomationProperties.Name="整轮结果通知" Click="SettingsToggle_Click" />
                                            <TextBlock Text="整轮汇总" Margin="16,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                                        <ComboBox x:Name="NotificationChannelComboBox" Width="112" SelectedIndex="0" AutomationProperties.Name="选择通知渠道">
                                            <ComboBoxItem x:Name="AddBarkChannelItem" Content="Bark" Tag="Bark" />
                                            <ComboBoxItem x:Name="AddNtfyChannelItem" Content="ntfy" Tag="Ntfy" />
                                        </ComboBox>
                                        <Button x:Name="AddNotificationChannelButton" Content="添加渠道" Margin="12,0,0,0"
                                                Style="{StaticResource SecondaryButton}" Click="AddNotificationChannel_Click" />
                                    </StackPanel>
                                </Grid>
                                <StackPanel x:Name="BarkChannelPanel" Visibility="Collapsed" Margin="0,18,0,0">
                                    <DockPanel LastChildFill="True">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <CheckBox x:Name="BarkEnabledCheckBox" Content="使用" VerticalAlignment="Center"
                                                      AutomationProperties.Name="启用 Bark 渠道" Click="SettingsToggle_Click" />
                                            <Button Content="测试" Tag="Bark" Margin="12,0,0,0" Style="{StaticResource SecondaryButton}"
                                                    AutomationProperties.Name="测试 Bark 通知" Click="TestNotificationButton_Click" />
                                            <Button Content="移除" Tag="Bark" Margin="8,0,0,0" Style="{StaticResource SecondaryButton}"
                                                    AutomationProperties.Name="移除 Bark 渠道" Click="RemoveNotificationChannel_Click" />
                                        </StackPanel>
                                        <TextBlock DockPanel.Dock="Left" Text="Bark" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <Border Height="1" Background="{StaticResource DividerBrush}" Margin="12,0,16,0" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="112" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="48" />
                                            <RowDefinition Height="48" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="服务地址" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" />
                                        <TextBox x:Name="BarkServerTextBox" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center"
                                                     AutomationProperties.Name="服务地址" KeyDown="SettingsTextInput_KeyDown"
                                                     LostKeyboardFocus="SettingsTextInput_LostKeyboardFocus" />
                                        <TextBlock Grid.Row="1" Text="设备密钥" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" />
                                        <PasswordBox x:Name="BarkDeviceKeyPasswordBox" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center"
                                                     Height="42" Padding="12,0" VerticalContentAlignment="Center"
                                                     Background="{StaticResource InputSurfaceBrush}" Foreground="{StaticResource PrimaryTextBrush}"
                                                     BorderBrush="{StaticResource DividerBrush}" BorderThickness="1"
                                                     AutomationProperties.Name="设备密钥" KeyDown="SettingsTextInput_KeyDown"
                                                     LostKeyboardFocus="SettingsTextInput_LostKeyboardFocus" />
                                    </Grid>
                                </StackPanel>
                                <StackPanel x:Name="NtfyChannelPanel" Visibility="Collapsed" Margin="0,18,0,0">
                                    <DockPanel LastChildFill="True">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <CheckBox x:Name="NtfyEnabledCheckBox" Content="使用" VerticalAlignment="Center"
                                                      AutomationProperties.Name="启用 ntfy 渠道" Click="SettingsToggle_Click" />
                                            <Button Content="测试" Tag="Ntfy" Margin="12,0,0,0" Style="{StaticResource SecondaryButton}"
                                                    AutomationProperties.Name="测试 ntfy 通知" Click="TestNotificationButton_Click" />
                                            <Button Content="移除" Tag="Ntfy" Margin="8,0,0,0" Style="{StaticResource SecondaryButton}"
                                                    AutomationProperties.Name="移除 ntfy 渠道" Click="RemoveNotificationChannel_Click" />
                                        </StackPanel>
                                        <TextBlock DockPanel.Dock="Left" Text="ntfy" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <Border Height="1" Background="{StaticResource DividerBrush}" Margin="12,0,16,0" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="112" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="48" />
                                            <RowDefinition Height="48" />
                                            <RowDefinition Height="48" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="服务地址" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" />
                                        <TextBox x:Name="NtfyServerTextBox" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center"
                                                     AutomationProperties.Name="服务地址" KeyDown="SettingsTextInput_KeyDown"
                                                     LostKeyboardFocus="SettingsTextInput_LostKeyboardFocus" />
                                        <TextBlock Grid.Row="1" Text="订阅主题" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" />
                                        <TextBox x:Name="NtfyTopicTextBox" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center"
                                                     AutomationProperties.Name="订阅主题" KeyDown="SettingsTextInput_KeyDown"
                                                     LostKeyboardFocus="SettingsTextInput_LostKeyboardFocus" />
                                        <TextBlock Grid.Row="2" Text="访问令牌（可选）" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" />
                                        <PasswordBox x:Name="NtfyTokenPasswordBox" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center"
                                                     Height="42" Padding="12,0" VerticalContentAlignment="Center"
                                                     Background="{StaticResource InputSurfaceBrush}" Foreground="{StaticResource PrimaryTextBrush}"
                                                     BorderBrush="{StaticResource DividerBrush}" BorderThickness="1"
                                                     AutomationProperties.Name="访问令牌（可选）" KeyDown="SettingsTextInput_KeyDown"
                                                     LostKeyboardFocus="SettingsTextInput_LostKeyboardFocus" />
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Expander>

                        <Expander Header="运行设置" Style="{StaticResource SettingsExpanderStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="112" />
                                    <ColumnDefinition Width="38" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="44" />
                                    <RowDefinition Height="44" />
                                    <RowDefinition Height="44" />
                                    <RowDefinition Height="44" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="启动最小化" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" />
                                <CheckBox x:Name="MinimizeOnStartupCheckBox" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center"
                                          Style="{StaticResource ToggleSwitchCheckBoxStyle}" AutomationProperties.Name="启动后最小化" Click="SettingsToggle_Click" />
                                <TextBlock Grid.Row="1" Text="启动运行" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" />
                                <CheckBox x:Name="RunWorkflowOnStartupCheckBox" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center"
                                          Style="{StaticResource ToggleSwitchCheckBoxStyle}" AutomationProperties.Name="启动后运行已启用任务" Click="SettingsToggle_Click" />
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="运行已启用任务" Margin="16,0,0,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="2" Text="结束退出" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" />
                                <CheckBox x:Name="ExitAfterWorkflowCompletesCheckBox" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center"
                                          Style="{StaticResource ToggleSwitchCheckBoxStyle}" AutomationProperties.Name="任务队列结束后退出 GachaOps" Click="SettingsToggle_Click" />
                                <TextBlock Grid.Row="2" Grid.Column="2" Text="任务队列结束后退出 GachaOps" Margin="16,0,0,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="3" Text="工具更新" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" />
                                <CheckBox x:Name="UpdateToolsBeforeLaunchCheckBox" Grid.Row="3" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center"
                                          Style="{StaticResource ToggleSwitchCheckBoxStyle}" AutomationProperties.Name="启动前自动更新工具" Click="SettingsToggle_Click" />
                                <TextBlock Grid.Row="3" Grid.Column="2" Text="启动前自动更新" Margin="16,0,0,0" VerticalAlignment="Center" />
                            </Grid>
                        </Expander>

                        <Expander Header="超时保护" Style="{StaticResource SettingsExpanderStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="112" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="48" />
                                    <RowDefinition Height="48" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="日志超时" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" />
                                <TextBox x:Name="NoLogTimeoutTextBox" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" AutomationProperties.Name="没有新日志的超时时间，分钟"
                                         KeyDown="SettingsTextInput_KeyDown" LostKeyboardFocus="SettingsTextInput_LostKeyboardFocus" />
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="分钟内没有新日志" Margin="12,0,0,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="1" Text="运行上限" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" />
                                <TextBox x:Name="HardTimeoutTextBox" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" AutomationProperties.Name="单项最长运行时间，分钟"
                                         KeyDown="SettingsTextInput_KeyDown" LostKeyboardFocus="SettingsTextInput_LostKeyboardFocus" />
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="分钟，单项最长运行" Margin="12,0,0,0" VerticalAlignment="Center" />
                            </Grid>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Margin="18,0,18,10" Background="{StaticResource ChromeBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                CornerRadius="6" Padding="18,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse x:Name="FooterStatusDot" Width="8" Height="8" Fill="#667085" />
                <TextBlock x:Name="FooterText" Text="正在加载…" Margin="9,0,0,0"
                           VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" />
            </StackPanel>
        </Border>

        <Grid x:Name="StartupCountdownOverlay" Grid.RowSpan="3" Panel.ZIndex="100"
              Visibility="Collapsed" Background="#66000000">
            <Border Width="500" Padding="34,28,34,30" HorizontalAlignment="Center"
                    VerticalAlignment="Center" Background="{StaticResource PageBackground}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="6">
                <StackPanel>
                    <TextBlock Text="即将运行已启用任务，是否取消？"
                               HorizontalAlignment="Center" TextAlignment="Center"
                               FontSize="17" FontWeight="SemiBold" />

                    <Grid Width="180" Height="180" Margin="0,28,0,22"
                          HorizontalAlignment="Center">
                        <Ellipse Stroke="{StaticResource DividerBrush}" StrokeThickness="12" />
                        <Ellipse Stroke="{StaticResource PrimaryBrush}" StrokeThickness="12"
                                 StrokeDashArray="31,19" StrokeStartLineCap="Round"
                                 StrokeEndLineCap="Round" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <RotateTransform x:Name="StartupCountdownRingRotation" />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock x:Name="StartupCountdownSecondsText" Text="10"
                                       HorizontalAlignment="Center" FontSize="42"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="秒后自动运行" Margin="0,2,0,0"
                                       HorizontalAlignment="Center"
                                       Foreground="{StaticResource MutedTextBrush}" />
                        </StackPanel>
                    </Grid>

                    <Button x:Name="CancelStartupRunButton" Content="取消" Width="112"
                            HorizontalAlignment="Center" Style="{StaticResource SecondaryButton}"
                            Click="CancelStartupRunButton_Click" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="ToolUpdateOverlay" Grid.RowSpan="3" Panel.ZIndex="101"
              Visibility="Collapsed" Background="#66000000">
            <Border Width="420" Padding="32,26" HorizontalAlignment="Center"
                    VerticalAlignment="Center" Background="{StaticResource PageBackground}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="6">
                <StackPanel>
                    <TextBlock x:Name="ToolUpdateStatusText" Text="正在检查更新…"
                               HorizontalAlignment="Center" TextAlignment="Center"
                               TextWrapping="Wrap" FontSize="16" FontWeight="SemiBold" />
                    <ProgressBar x:Name="ToolUpdateProgressBar" Height="4" Margin="0,18,0,0"
                                 BorderThickness="0" Background="{StaticResource DividerBrush}"
                                 Foreground="{StaticResource PrimaryBrush}" IsIndeterminate="True" />
                    <Button x:Name="CancelToolUpdateButton" Content="取消启动" Width="112" Margin="0,20,0,0"
                            HorizontalAlignment="Center" Style="{StaticResource SecondaryButton}"
                            Click="CancelToolUpdateButton_Click" />
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</Window>
